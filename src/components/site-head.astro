---
import { Font } from "astro:assets"
import { adsenseClient } from "@/lib/google-config"
import { languages, resolveLocale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"
import { brand } from "@/lib/brand"

interface Props {
  title: string
  noindex: boolean
  description?: string
}

const { title, noindex } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const description = Astro.props.description ?? t.description
const canonical = new URL(Astro.url.pathname, Astro.site)
const rootUrl = new URL("/", Astro.site)
const shareImage = new URL(languages[locale].shareImage, Astro.site)
const siteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: brand.name,
  alternateName: t.title,
  url: rootUrl.href,
  inLanguage: locale,
}
---

<title>{title}</title>
<script is:inline>
  // Links with data-motion pick how the card moves into the next page.
  ;(() => {
    const key = "news-shuffle.motion"
    const session = (action) => {
      try {
        return action(sessionStorage)
      } catch {
        return null
      }
    }
    addEventListener(
      "click",
      (event) => {
        if (event.button || event.metaKey || event.ctrlKey || event.shiftKey)
          return
        const link = event.target.closest?.("a[data-motion]")
        if (!link) return
        document.documentElement.dataset.motion = link.dataset.motion
        session((store) => store.setItem(key, link.dataset.motion))
      },
      true
    )
    addEventListener("pageshow", (event) => {
      if (event.persisted) delete document.documentElement.dataset.motion
    })
    addEventListener("pagereveal", (event) => {
      const motion = session((store) => store.getItem(key))
      session((store) => store.removeItem(key))
      if (!event.viewTransition || !motion) return
      const root = document.documentElement
      root.dataset.motion = motion
      event.viewTransition.finished.finally(() => delete root.dataset.motion)
    })
  })()
</script>
<Font cssVariable="--font-geist" preload />
<Font cssVariable="--font-manufacturing-consent" preload />
<Font cssVariable="--font-newsreader" preload />
<link rel="icon" type="image/png" sizes="64x64" href="/icons/favicon-64.png" />
<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/icons/apple-touch-icon.png"
/>
<link rel="manifest" href="/site.webmanifest" />
{noindex && <meta name="robots" content="noindex" />}
<>
  <meta name="description" content={description} />
  <meta name="google-adsense-account" content={adsenseClient} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={brand.name} />
  <meta property="og:locale" content={languages[locale].socialLocale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${t.headline} ${t.description}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />
  <meta name="twitter:image:alt" content={`${t.headline} ${t.description}`} />
  {Astro.url.pathname === "/" && (
    <script type="application/ld+json" set:html={JSON.stringify(siteData)} />
  )}
</>
