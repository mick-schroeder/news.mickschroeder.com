---
import { SourceIcon } from "@/components/source-icon"
import { tierColors } from "@/components/tier-badge"
import { Card } from "@/components/ui/card"
import type { Source, TierInfo } from "@/lib/shuffle"

interface Props {
  sources: Source[]
  tiers: TierInfo[]
}

const { sources, tiers } = Astro.props
const rows = tiers
  .map((tier) => ({
    tier,
    sources: sources.filter((source) => source.tier === tier.id),
  }))
  .filter((row) => row.sources.length)
---

<!-- A tier list: one row per tier, best first; rows link as #tier-s etc. -->
<Card className="gap-0 py-0">
  {rows.map(({ tier, sources }) => (
    <section
      id={`tier-${tier.id.toLowerCase()}`}
      class="flex scroll-mt-4 border-b last:border-b-0"
      aria-label={`Tier ${tier.id}: ${tier.title}`}
    >
      <div
        class:list={[
          "flex w-16 shrink-0 items-center justify-center text-4xl font-black text-black sm:w-24 sm:text-5xl",
          tierColors[tier.id],
        ]}
        title={`${tier.title}. ${tier.description}`}
      >
        {tier.id}
      </div>
      <ul class="flex min-h-20 min-w-0 flex-1 flex-wrap content-start gap-1.5 p-2 sm:min-h-24 sm:gap-2 sm:p-3">
        {sources.map((source) => (
          <li>
            <a
              href={`/sources/${source.id}/`}
              title={source.title}
              class="block rounded-[22%] transition-transform motion-safe:hover:-translate-y-0.5"
            >
              <SourceIcon source={source} className="size-10 sm:size-12" />
              <span class="sr-only">{source.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Card>
