---
import { Redirect, RedirectCard } from "@/components/redirect-card"
import Layout from "@/layouts/main.astro"
import { getTiers } from "@/lib/data"
import type { Source } from "@/lib/shuffle"

interface Props {
  title: string
  sources: Source[]
  /** Use the visitor's saved filters. */
  savedFilters?: boolean
}

const { title, sources, savedFilters = false } = Astro.props
const data = sources.map(({ title, url, icon, tier, tags }) => ({
  title,
  url,
  icon,
  tier,
  tags,
}))
const tiers = await getTiers()
---

<Layout title={title} description={title} noindex>
  <div class="flex min-h-[60svh] flex-col items-center justify-center">
    <Redirect
      client:only="react"
      sources={data}
      tiers={tiers}
      savedFilters={savedFilters}
    >
      <RedirectCard slot="fallback" loading />
    </Redirect>
    <noscript>
      <p class="mt-4 text-muted-foreground">
        Shuffling needs JavaScript.{" "}
        <a href="/" class="underline">
          Go home
        </a>
        .
      </p>
    </noscript>
  </div>
</Layout>
