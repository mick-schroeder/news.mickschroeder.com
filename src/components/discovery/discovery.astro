---
import { getRelativeLocaleUrl } from "astro:i18n"
import { translations, type Locale } from "@/i18n/ui"
import { DiscoveryControls } from "./discovery-controls"
import SourcesSection from "./sources-section.astro"
import AdUnit from "@/components/ad-unit.astro"
import { googleTagsEnabled } from "@/lib/google-config"
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = translations[locale]
---

<main
  id="discovery"
  data-locale={locale}
  class="page-width grid max-w-5xl grid-cols-1 items-start gap-8 pt-8 lg:grid-cols-2 lg:pt-14"
>
  <section class="min-w-0">
    <h1 class="text-balance text-5xl font-extrabold tracking-tighter leading-[0.92] text-foreground sm:text-6xl lg:text-7xl">
      {t.headline}
    </h1>
    <p class="mt-5 max-w-md text-lg text-muted-foreground sm:text-xl">
      {t.description}
    </p>
  </section>
  <DiscoveryControls client:load locale={locale} />
  <noscript>
    <style is:inline>
      #discovery-controls {
        display: none;
      }
    </style>
    <div class="col-span-full space-y-4 rounded-xl border border-border bg-card p-6 text-sm text-card-foreground">
      <p>{t.noscript}</p>
      <a
        href={getRelativeLocaleUrl(locale, "sources/")}
        class="inline-block font-semibold text-foreground underline"
      >
        {t.browse}
      </a>
    </div>
  </noscript>
  {googleTagsEnabled && <AdUnit />}
  <SourcesSection locale={locale} />
</main>
<script>
  import { storageKeys, writeStorage } from "@/lib/browser-storage"

  const locale =
    document.querySelector<HTMLElement>("#discovery")?.dataset.locale
  if (locale) writeStorage(storageKeys.locale, locale)
</script>
