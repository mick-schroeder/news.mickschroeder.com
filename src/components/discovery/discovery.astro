---
import { getRelativeLocaleUrl } from "astro:i18n"
import { resolveLocale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"
import { DiscoveryControls } from "./discovery-controls"
import { FilterSentence } from "./filter-sentence"
import SourcesSection from "./sources-section.astro"
import AdUnit from "@/components/ad-unit.astro"
import { Card } from "@/components/ui/card"
import { googleTagsEnabled } from "@/lib/google-config"
import { getTags } from "@/lib/catalog"
const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const tags = await getTags()
---

<main id="discovery" class="page-width grid grid-cols-1 items-start gap-4">
  <FilterSentence client:load locale={locale} tags={tags} />
  <section class="min-w-0 text-center">
    <h1 class="font-headline text-balance text-4xl font-semibold tracking-tight leading-none text-foreground sm:text-5xl lg:text-6xl">
      {t.headline}
    </h1>
    <p class="mx-auto mt-2 max-w-md text-base text-muted-foreground sm:text-lg">
      {t.description}
    </p>
  </section>
  <DiscoveryControls client:load locale={locale} tags={tags} />
  <noscript>
    <style is:inline>
      #discovery-controls {
        display: none;
      }
    </style>
    <Card className="col-span-full px-6 text-sm">
      <p>{t.noscript}</p>
      <a href={getRelativeLocaleUrl(locale, "sources/")} class="link">
        {t.browse}
      </a>
    </Card>
  </noscript>
  {googleTagsEnabled && <AdUnit />}
  <SourcesSection />
</main>
