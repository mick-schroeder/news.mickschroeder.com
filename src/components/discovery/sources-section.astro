---
import { getRelativeLocaleUrl } from "astro:i18n"
import { translations, type Locale } from "@/i18n/ui"
import { getSites } from "@/lib/catalog"
import { SiteIcon } from "@/components/sources/site-icon"
import { filterSites } from "@/lib/sites"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = translations[locale]

// The headliners, alternating between two rows.
const headliners = filterSites(await getSites(), {
  topics: [],
  regions: [],
  seenOn: [],
  lowestTier: "A",
})
const rows = [0, 1].map((row) =>
  headliners.filter((_, index) => index % 2 === row)
)
---

<section class="discovery-section-grid" aria-labelledby="sources-title">
  <div class="space-y-1">
    <h2 id="sources-title" class="discovery-section-title">
      {t.sources}
    </h2>
    <p class="discovery-section-subtitle">{t.sourcesHint}</p>
    <p class="pt-2 text-sm">
      <a
        href={getRelativeLocaleUrl(locale, "sources/")}
        class="font-medium text-foreground underline underline-offset-4 hover:text-primary"
      >
        {t.browse}
      </a>
    </p>
  </div>

  <!-- Each row runs twice for a seamless loop; the copy is hidden from
       assistive tech and the tab order. Hover or focus pauses it. -->
  <div class="grid min-w-0 gap-2 overflow-hidden mask-x-from-85%">
    {rows.map((row, index) => (
      <div
        class:list={[
          "flex w-max hover:[animation-play-state:paused] has-focus-visible:[animation-play-state:paused]",
          index === 0
            ? "motion-safe:animate-source-marquee-reverse"
            : "motion-safe:animate-source-marquee",
        ]}
        style={{ animationDuration: "70s" }}
      >
        {[false, true].map((copy) => (
          <ul
            class="flex gap-2 py-1 pr-2"
            aria-label={copy ? undefined : t.sources}
            aria-hidden={copy ? "true" : undefined}
          >
            {row.map((site) => (
              <li data-marquee-tile>
                <a
                  href={getRelativeLocaleUrl(locale, `sources/${site.id}/`)}
                  title={site.title}
                  tabindex={copy ? -1 : undefined}
                  class="block rounded-xl outline-none transition-transform focus-visible:ring-3 focus-visible:ring-ring motion-safe:hover:-translate-y-0.5"
                >
                  <SiteIcon site={site} size="md" />
                  <span class="sr-only">{site.title}</span>
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    ))}
  </div>
</section>
