---
import { getRelativeLocaleUrl } from "astro:i18n"
import { SourceTable } from "./source-tables"
import type { Locale } from "@/i18n/locales"
import type { Source } from "@/lib/source-pages"

interface Props {
  locale: Locale
  sources: Source[]
}

const { locale, sources } = Astro.props
const hrefs = Object.fromEntries(
  sources.map((s) => [s.id, getRelativeLocaleUrl(locale, `sources/${s.id}/`)])
)
---

<SourceTable sources={sources} hrefFor={(source) => hrefs[source.id]} />
