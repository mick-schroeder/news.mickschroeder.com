---
import { getRelativeLocaleUrl } from "astro:i18n"
import { tierColors } from "@/components/tier-badge"
import { format, translations, type Locale } from "@/i18n/ui"
import { byTier, type Site } from "@/lib/sites"
import { cn } from "@/lib/utils"
import { SiteIcon } from "./site-icon"

interface Props {
  locale: Locale
  sites: Site[]
}

const { locale, sites } = Astro.props
const t = translations[locale]
const sitePath = (id: string) => getRelativeLocaleUrl(locale, `sources/${id}/`)
---

<div class="rounded-2xl border border-border bg-card">
  {byTier(sites).map(({ tier, sites }) => (
    <section
      id={`tier-${tier.toLowerCase()}`}
      class="group/row flex scroll-mt-24 border-b border-border"
      aria-label={format(t.tierLabel, { tier })}
      data-tier-row
    >
      <div
        class={cn(
          "flex w-14 shrink-0 flex-col items-center justify-center gap-0.5 p-2 text-center sm:w-20",
          tierColors[tier]
        )}
        aria-hidden="true"
      >
        <span class="text-3xl leading-none font-black sm:text-4xl">{tier}</span>
      </div>
      <ul class="flex min-h-20 min-w-0 flex-1 flex-wrap content-start gap-1.5 p-2 sm:gap-2 sm:p-3">
        {sites.map((site) => (
          <li class="relative">
            <a
              href={sitePath(site.id)}
              class="group/tile block rounded-xl outline-none transition-transform focus-visible:ring-3 focus-visible:ring-ring motion-safe:hover:-translate-y-0.5"
            >
              <SiteIcon site={site} size="md" />
              <span class="sr-only">{site.title}</span>
              <span
                class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-1.5 -translate-x-1/2 rounded-md bg-foreground px-2 py-1 text-xs font-medium whitespace-nowrap text-background opacity-0 transition-opacity group-hover/tile:opacity-100 group-focus-visible/tile:opacity-100"
                aria-hidden="true"
              >
                {site.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* Round the tier column into the card's corners; no overflow clip, so tooltips show. */
  [data-tier-row]:first-child > :first-child {
    border-top-left-radius: calc(var(--radius-2xl) - 1px);
  }
  [data-tier-row]:last-child {
    border-bottom: 0;
  }
  [data-tier-row]:last-child > :first-child {
    border-bottom-left-radius: calc(var(--radius-2xl) - 1px);
  }
</style>
