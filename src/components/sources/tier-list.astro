---
import { getRelativeLocaleUrl } from "astro:i18n"
import { TierBadge } from "@/components/tier-badge"
import { resolveLocale } from "@/i18n/locales"
import { format, translations } from "@/i18n/ui"
import { byTier, type Source } from "@/lib/sources"
import { SourceIcon } from "./source-icon"

interface Props {
  sources: Source[]
}

const { sources } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const sourcePath = (id: string) =>
  getRelativeLocaleUrl(locale, `sources/${id}/`)
---

<div class="rounded-4xl bg-card shadow-md ring-1 ring-foreground/5 dark:ring-foreground/10">
  {byTier(sources).map(({ tier, sources }) => (
    <section
      id={`tier-${tier.toLowerCase()}`}
      class="group/row flex scroll-mt-24 border-b border-border"
      aria-label={format(t.tierLabel, { tier })}
      data-tier-row
    >
      <div class="flex w-16 shrink-0 items-center justify-center border-r border-border p-2 sm:w-20">
        <TierBadge tier={tier} locale={locale} size="lg" />
      </div>
      <ul class="flex min-h-20 min-w-0 flex-1 flex-wrap content-start gap-1.5 p-2 sm:gap-2 sm:p-3">
        {sources.map((source) => (
          <li class="relative">
            <a
              href={sourcePath(source.id)}
              class="group/tile block rounded-xl outline-none transition-transform focus-visible:ring-3 focus-visible:ring-ring motion-safe:hover:-translate-y-0.5"
            >
              <SourceIcon source={source} size="md" />
              <span class="sr-only">{source.title}</span>
              <span
                class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-1.5 hidden -translate-x-1/2 rounded-md bg-foreground px-2 py-1 text-xs font-medium whitespace-nowrap text-background group-hover/tile:block group-focus-visible/tile:block"
                aria-hidden="true"
              >
                {source.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  /* Round the tier column into the card's corners; no overflow clip, so labels show. */
  [data-tier-row]:first-child > :first-child {
    border-top-left-radius: var(--radius-4xl);
  }
  [data-tier-row]:last-child {
    border-bottom: 0;
  }
  [data-tier-row]:last-child > :first-child {
    border-bottom-left-radius: var(--radius-4xl);
  }
</style>
