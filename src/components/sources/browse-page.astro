---
import Layout from "@/layouts/main.astro"
import { PageBreadcrumb, type Crumb } from "./page-breadcrumb"
import { resolveLocale } from "@/i18n/locales"

interface Props {
  title: string
  heading?: string
  description: string
  crumbs: Crumb[]
}

const { title, heading = title, description, crumbs } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
---

<Layout title={title} description={description}>
  <main class="page-width space-y-6 pt-2 sm:pt-4">
    <header class="space-y-4">
      <PageBreadcrumb locale={locale} crumbs={crumbs} />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0 space-y-1.5">
          <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            {heading}
          </h1>
          <slot name="description" />
        </div>
        <div class="flex shrink-0 gap-2 empty:hidden">
          <slot name="actions" />
        </div>
      </div>
    </header>
    <slot />
  </main>
</Layout>
