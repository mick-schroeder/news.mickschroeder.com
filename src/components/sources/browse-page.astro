---
import Layout from "@/layouts/main.astro"
import { PageBreadcrumb, type Crumb } from "./page-breadcrumb"
import type { Locale } from "@/i18n/locales"

interface Props {
  locale: Locale
  title: string
  heading: string
  description: string
  languageSuffix: string
  crumbs: Crumb[]
}

const { locale, title, heading, description, languageSuffix, crumbs } =
  Astro.props
---

<Layout
  locale={locale}
  title={title}
  description={description}
  languageSuffix={languageSuffix}
>
  <main class="page-width max-w-5xl space-y-6 pt-4 sm:pt-8">
    <header class="space-y-4">
      <PageBreadcrumb crumbs={crumbs} />
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0 space-y-1.5">
          <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            {heading}
          </h1>
          <slot name="description" />
        </div>
        <div class="flex shrink-0 gap-2 empty:hidden">
          <slot name="actions" />
        </div>
      </div>
    </header>
    <slot />
  </main>
</Layout>
