---
import { ExternalLink } from "@/components/external-link"
import { SiteNav } from "@/components/site-nav"
import { buttonVariants } from "@/components/ui/button"
import { OWNER, SITE_TITLE } from "@/consts"

const year = new Date().getFullYear()
const links = [
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
]
---

<footer class="mx-auto mt-16 w-full max-w-5xl px-4 sm:px-8">
  <SiteNav
    label="Legal"
    links={links}
    path={Astro.url.pathname}
    className="border-t-4 border-b border-double border-foreground/25 py-1.5"
  />
  <div class="flex justify-center">
    <button
      id="privacy-choices"
      type="button"
      class={buttonVariants({ variant: "link", size: "sm" })}
      hidden
    >
      Privacy and cookie settings
    </button>
  </div>
  <div class="flex flex-col items-center gap-1 py-6 text-center">
    <a href="/" class="font-logo text-2xl leading-none">
      {SITE_TITLE}
    </a>
    <p class="text-xs text-muted-foreground">
      © 2021–{year}{" "}
      <ExternalLink href={OWNER.url} className="hover:text-foreground">
        {OWNER.name}
      </ExternalLink>
    </p>
  </div>
</footer>

<script>
  // Reopens Google's consent message, on pages that load AdSense.
  const button = document.getElementById("privacy-choices")!
  if (document.querySelector("script[src*='adsbygoogle']")) {
    button.hidden = false
    button.addEventListener("click", () => {
      const fc = ((window as any).googlefc ??= { callbackQueue: [] })
      fc.callbackQueue.push(() => fc.showRevocationMessage())
    })
  }
</script>
