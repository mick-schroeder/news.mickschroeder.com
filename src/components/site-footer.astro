---
import { getRelativeLocaleUrl } from "astro:i18n"
import ExternalLink from "@/components/external-link.astro"
import { resolveLocale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"
import { site } from "@/lib/site"

interface Props {
  /** Shows the button that reopens Google's consent message. */
  privacyChoices: boolean
}

const { privacyChoices } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const pages = ["sources", "tags", "about", "privacy", "terms"] as const
const links = pages.map((page) => ({
  label: t[page],
  href: getRelativeLocaleUrl(locale, `${page}/`),
}))
const years = `${site.since}-${new Date().getFullYear()}`
---

<footer class="page-width mt-12 max-w-5xl border-t border-border py-10 text-xs text-muted-foreground sm:py-12">
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <b class="text-foreground">{site.name}™</b> © {years}
    <ExternalLink href={site.ownerUrl} class="link">
      {site.owner}
    </ExternalLink>
    {links.map(({ label, href }) => (
      <>
        <span aria-hidden="true"> · </span>
        <a href={href} class="link">
          {label}
        </a>
      </>
    ))}
    {privacyChoices && (
      <span id="privacy-choices" class="contents" hidden>
        <span aria-hidden="true"> · </span>
        <button type="button" class="link">
          {t.privacyChoices}
        </button>
      </span>
    )}
  </p>
</footer>
