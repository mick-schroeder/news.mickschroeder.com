---
import { Shuffle } from "lucide-react"
import { ModeToggle } from "@/components/mode-toggle"
import { SiteNav } from "@/components/site-nav"
import { SITE_TITLE } from "@/consts"

const links = [
  { href: "/", label: "Home" },
  { href: "/sources/", label: "Sources" },
  { href: "/tags/", label: "Tags" },
  { href: "/about/", label: "About" },
]
const path = Astro.url.pathname
---

<header class="mx-auto w-full max-w-5xl px-4 [view-transition-name:site-header] sm:px-8">
  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 py-4 sm:py-6">
    <time
      id="masthead-date"
      class="hidden text-sm text-muted-foreground sm:block"
    ></time>
    <a href="/" class="col-start-2 flex items-center gap-2.5 sm:gap-3">
      <span class="flex size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground sm:size-11">
        <Shuffle
          className="size-4 sm:size-6"
          strokeWidth={3}
          aria-hidden="true"
        />
      </span>
      <span class="font-logo text-3xl leading-none whitespace-nowrap sm:text-6xl">
        {SITE_TITLE}
      </span>
    </a>
    <div class="justify-self-end">
      <ModeToggle client:load />
    </div>
  </div>
  <SiteNav
    label="Main"
    links={links}
    path={path}
    className="border-t border-b-4 border-double border-foreground/25 py-1.5"
  />
</header>

<script>
  // Static pages can't know today's date, so the browser fills it in.
  const date = document.getElementById("masthead-date") as HTMLTimeElement
  const now = new Date()
  date.dateTime = now.toISOString().slice(0, 10)
  date.textContent = now.toLocaleDateString("en", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  })
</script>
