---
import { ExternalLink as ExternalIcon } from "lucide-react"
import { resolveLocale, type Locale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"

interface Props {
  href: string
  class?: string
  /** Language of the surrounding text, if not the page's. */
  locale?: Locale
}

// Links that leave the site open in a new tab and say so with an icon.
const {
  href,
  class: className,
  locale = resolveLocale(Astro.currentLocale),
} = Astro.props
---

<a href={href} target="_blank" rel="noopener noreferrer" class={className}>
  <slot />
  <ExternalIcon
    className="ml-0.5 inline size-3 align-[-0.05em]"
    aria-hidden="true"
  />
  <span class="sr-only"> ({translations[locale].opensInNewTab})</span>
</a>
