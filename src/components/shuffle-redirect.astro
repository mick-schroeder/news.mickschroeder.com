---
import { ExternalLink, Globe } from "lucide-react"
import { Skeleton } from "@/components/ui/skeleton"
import { buttonVariants } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import {
  Item,
  ItemActions,
  ItemContent,
  ItemDescription,
  ItemMedia,
  ItemTitle,
} from "@/components/ui/item"
import Layout from "@/layouts/main.astro"
import { translations } from "@/i18n/ui"

import { defaultLocale, locales, type Locale } from "@/i18n/locales"
import { getRelativeLocaleUrl } from "astro:i18n"
import { getTags } from "@/lib/catalog"

interface Props {
  /** Fixed language, e.g. for /ga/tags/…/redirect/. Otherwise the last one used. */
  locale?: Locale
  /** Shuffle sites with this tag instead of the visitor's saved filters. */
  tag?: string
}

const { locale, tag } = Astro.props
const tags = await getTags()

const homeUrls = Object.fromEntries(
  locales.map((locale) => [locale, getRelativeLocaleUrl(locale)])
)

const t = translations[locale ?? defaultLocale]
const destinationRow = "min-h-18 flex-nowrap"
---

<Layout locale={locale} title={t.redirecting} noindex>
  <meta slot="head" name="referrer" content="no-referrer" />
  <main
    data-home-urls={JSON.stringify(homeUrls)}
    data-locale={locale}
    data-tag={tag}
    data-tags={JSON.stringify(tags)}
    class="redirect-page page-width max-w-lg min-h-[60vh] py-16"
  >
    <Card>
      <CardHeader>
        <CardTitle>
          <h1 id="redirect-title">{t.redirecting}</h1>
        </CardTitle>
      </CardHeader>
      <CardContent>
        <div aria-live="polite" aria-atomic="true">
          <div id="redirect-loading">
            <Item
              variant="outline"
              className={destinationRow}
              aria-hidden="true"
            >
              <ItemMedia>
                <Skeleton className="size-10 rounded-full motion-reduce:animate-none" />
              </ItemMedia>
              <ItemContent className="min-w-0 gap-2">
                <Skeleton className="h-4 w-2/5 motion-reduce:animate-none" />
                <Skeleton className="h-3 w-3/5 motion-reduce:animate-none" />
              </ItemContent>
            </Item>
          </div>
          <a
            id="redirect-destination"
            class="block rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ring motion-safe:animate-in motion-safe:duration-200 motion-safe:fade-in"
            hidden
          >
            <Item
              variant="outline"
              className={`${destinationRow} group hover:bg-muted`}
            >
              <ItemMedia>
                <span class="grid size-10 place-items-center rounded-full bg-muted text-muted-foreground">
                  <Globe size={16} aria-hidden="true" />
                </span>
              </ItemMedia>
              <ItemContent className="min-w-0">
                <ItemTitle
                  id="redirect-site-name"
                  className="line-clamp-none wrap-anywhere"
                />
                <ItemDescription
                  id="redirect-site-url"
                  className="line-clamp-none wrap-anywhere"
                />
              </ItemContent>
              <ItemActions>
                <ExternalLink className="size-4" aria-hidden="true" />
              </ItemActions>
            </Item>
          </a>
          <button
            id="redirect-retry"
            type="button"
            class={buttonVariants({ variant: "outline" })}
            hidden
          >
            {t.retry}
          </button>
          <div
            id="redirect-empty"
            class="space-y-4 motion-safe:animate-in motion-safe:duration-200 motion-safe:fade-in"
            hidden
          >
            <a
              id="choose-filters"
              href="/"
              class={buttonVariants({ variant: "outline" })}
            >
              {t.choose}
            </a>
          </div>
        </div>
        <noscript>
          <style is:inline>
            #redirect-loading {
              display: none;
            }
          </style>
          <div class="space-y-4">
            <p class="text-muted-foreground">{t.noscript}</p>
            <a href="/" class={buttonVariants({ variant: "outline" })}>
              {t.choose}
            </a>
          </div>
        </noscript>
      </CardContent>
    </Card>
  </main>
</Layout>

<script>
  import {
    addToHistory,
    loadSites,
    readFilters,
    readHistory,
    readStorage,
    storageKeys,
  } from "@/lib/browser-storage"
  import { filterSites, pickSite, type Site } from "@/lib/sites"
  import { resolveLocale } from "@/i18n/locales"
  import { translations } from "@/i18n/ui"

  const page = document.querySelector<HTMLElement>(".redirect-page")!
  const title = document.getElementById("redirect-title")!
  const loading = document.getElementById("redirect-loading")!
  const empty = document.getElementById("redirect-empty")!
  const setup = document.querySelector<HTMLAnchorElement>("#choose-filters")!
  const destination = document.querySelector<HTMLAnchorElement>(
    "#redirect-destination"
  )!
  const siteName = document.getElementById("redirect-site-name")!
  const siteUrl = document.getElementById("redirect-site-url")!
  const retry = document.getElementById("redirect-retry")!
  let timer: number | undefined
  let request: AbortController | undefined

  function cancelRedirect() {
    window.clearTimeout(timer)
    request?.abort()
  }

  async function redirect() {
    cancelRedirect()
    const controller = new AbortController()
    request = controller
    const locale = resolveLocale(
      page.dataset.locale ?? readStorage(storageKeys.locale)
    )
    const t = translations[locale]
    document.documentElement.lang = locale
    document.title = t.redirecting
    title.textContent = t.redirecting
    destination.hidden = true
    loading.hidden = false
    empty.hidden = true
    retry.hidden = true

    const tag = page.dataset.tag
    let site: Site | undefined
    try {
      const sites = await loadSites(controller.signal)
      if (controller.signal.aborted) return
      const pool = tag
        ? sites.filter((candidate) => candidate.tags.includes(tag))
        : filterSites(sites, readFilters(JSON.parse(page.dataset.tags!)))
      site = pickSite(pool, readHistory())
    } catch {
      if (controller.signal.aborted) return
      loading.hidden = true
      title.textContent = t.catalogError
      retry.textContent = t.retry
      retry.hidden = false
      return
    }

    if (!site) {
      loading.hidden = true
      empty.hidden = false
      title.textContent = t.empty
      setup.textContent = t.choose
      setup.href = JSON.parse(page.dataset.homeUrls!)[locale]
      return
    }

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches
    timer = window.setTimeout(
      () => {
        siteName.textContent = site.title
        siteUrl.textContent = site.url
        destination.href = site.url
        loading.hidden = true
        destination.hidden = false
        addToHistory(site.id)
        timer = window.setTimeout(
          () => location.replace(site.url),
          reducedMotion ? 0 : 250
        )
      },
      reducedMotion ? 0 : 650
    )
  }

  retry.addEventListener("click", redirect)
  redirect()
  window.addEventListener("pagehide", cancelRedirect)
  // A restored bookmark page should shuffle again.
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) redirect()
  })
</script>
