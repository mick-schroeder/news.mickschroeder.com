---
const faces = [
  "border-primary/40 bg-primary text-primary-foreground",
  "brand-card-back border-border bg-foreground text-primary",
]
---

<span class="relative inline-block size-9 select-none" aria-hidden="true">
  <span class="brand-card-flipper absolute inset-0">
    {faces.map((face) => (
      <span
        class:list={[
          "brand-card-face absolute inset-0 flex items-center justify-center rounded-lg border",
          face,
        ]}
      >
        <svg class="size-5" viewBox="0 0 507.45 415.1" fill="currentColor">
          <path d="m0 318.3c0 17.8 14.6 32.3 32.4 32.3h49.5c36.7 0 60.2-12.2 79.9-37.5l121.3-154.3c16.9-21.7 28.4-28.5 55.1-28.5h34.5v36.4c0 15.5 9.5 25.2 24.6 25.2 7.2 0 12.6-2.5 16.9-6.2l84.9-72.5c11.1-9.5 10.9-25.3 0-34.7l-84.9-72.3c-4.3-3.6-9.7-6.2-16.9-6.2-15 0-24.6 9.7-24.6 25.2v40.5h-29c-42.1 0-73.2 10.5-103.1 48.7l-110.9 142.6c-15.6 20.1-31.2 28.9-59.2 28.9h-38.1c-17.9.1-32.4 14.6-32.4 32.4zm0-220.3c0 17.8 14.6 32.3 32.4 32.3h31.6c28 0 50.1 9 65.7 28.9l117 149.4c23.6 30 59.7 42 96.4 42h29.7v39.3c0 15.5 9.5 25.2 24.6 25.2 7.2 0 12.6-2.5 16.9-6.2l84.9-72.5c11.1-9.5 10.9-25.4 0-34.7l-84.9-72.2c-4.3-3.7-9.7-6.2-16.9-6.2-15 0-24.6 9.7-24.6 25.2v37.6h-28.9c-28 0-46-9.2-61.6-29.2l-120.5-153.7c-19.7-25.2-49.7-37.5-86.4-37.5h-43c-17.9 0-32.4 14.5-32.4 32.3z" />
        </svg>
      </span>
    ))}
  </span>
</span>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .brand-card-flipper {
      transform-style: preserve-3d;
      animation: shuffle-flip 4.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
  }

  .brand-card-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .brand-card-back {
    transform: rotateY(180deg);
  }

  @keyframes shuffle-flip {
    0% {
      transform: perspective(400px) rotateY(0deg) translateY(0) scale(1);
    }
    6% {
      transform: perspective(400px) rotateY(-20deg) translateY(-2px) scale(0.96);
    }
    22% {
      transform: perspective(400px) rotateY(180deg) translateY(-7px) scale(1.1);
    }
    38% {
      transform: perspective(400px) rotateY(360deg) translateY(-1px) scale(1.02);
    }
    46% {
      transform: perspective(400px) rotateY(360deg) translateY(0) scale(1);
    }
    100% {
      transform: perspective(400px) rotateY(360deg) translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) .brand-card-flipper {
      animation-duration: 2s;
    }
  }
</style>
