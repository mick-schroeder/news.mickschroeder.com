---
import PageHeader from "@/components/page-header.astro"
import Layout from "@/layouts/main.astro"

interface Props {
  title: string
  description: string
  jsonLd?: Record<string, unknown>[]
}

const { title, description, jsonLd } = Astro.props
---

<Layout
  title={`${title} | News Shuffle`}
  description={description}
  jsonLd={jsonLd}
  crumbs={[{ name: title, path: Astro.url.pathname }]}
>
  <PageHeader title={title} />
  <article class="max-w-2xl space-y-4 leading-relaxed text-muted-foreground [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:text-foreground">
    <slot />
  </article>
</Layout>
