---
import PageHeader from "@/components/page-header.astro"
import Layout from "@/layouts/main.astro"

interface Props {
  frontmatter: {
    title: string
    description: string
  }
}

const { title, description } = Astro.props.frontmatter
---

<Layout
  title={`${title} | News Shuffle`}
  description={description}
  crumbs={[{ name: title, path: Astro.url.pathname }]}
>
  <PageHeader title={title} />
  <article class="prose prose-stone dark:prose-invert">
    <slot />
  </article>
</Layout>
