---
import "@/styles/global.css"
import SiteHead from "@/components/site-head.astro"
import GoogleTags from "@/components/google-tags.astro"
import BrandLogo from "@/components/brand-logo.astro"
import ExternalLink from "@/components/external-link.astro"
import LanguagePicker from "@/components/language-picker.astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import { defaultLocale } from "@/i18n/locales"
import { googleTagsEnabled } from "@/lib/google-config"
import { translations, type Locale } from "@/i18n/ui"

interface Props {
  locale?: Locale
  title?: string
  description?: string
  noindex?: boolean
  languageSuffix?: string
}
const {
  locale = defaultLocale,
  noindex = false,
  languageSuffix = "",
} = Astro.props
const t = translations[locale]
const currentPath = getRelativeLocaleUrl(locale)
const title = Astro.props.title ?? t.title
const showGoogleTags = googleTagsEnabled && !noindex
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SiteHead
      locale={locale}
      title={title}
      noindex={noindex}
      description={Astro.props.description}
      languageSuffix={languageSuffix}
    />
    <slot name="head" />
    {showGoogleTags && <GoogleTags />}
  </head>
  <body>
    <a
      class="fixed top-3 left-3 z-50 -translate-y-[160%] rounded-lg border bg-card px-4 py-2.5 text-foreground transition-transform focus:translate-y-0 motion-reduce:transition-none"
      href="#main-content"
    >
      {t.skip}
    </a>
    <header class="page-width flex max-w-5xl items-center justify-between gap-4 py-6 sm:py-8">
      <a
        class="group inline-flex items-center gap-3 text-lg font-bold tracking-tight text-foreground transition-opacity hover:opacity-90"
        href={currentPath}
      >
        <BrandLogo />
        <span>News Shuffle</span>
      </a>
      <LanguagePicker locale={locale} languageSuffix={languageSuffix} />
    </header>
    <div id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </div>
    <footer class="page-width mt-12 max-w-5xl border-t border-border py-10 text-xs text-muted-foreground sm:py-12">
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <b class="text-foreground">News Shuffle™</b> © 2021-2026{" "}
        <ExternalLink
          href="https://www.mickschroeder.com/"
          class="underline hover:text-primary transition-colors"
          locale={locale}
        >
          Mick Schroeder, LLC
        </ExternalLink>
        <span aria-hidden="true"> · </span>
        <a
          href={getRelativeLocaleUrl(locale, "sources/")}
          class="underline hover:text-primary transition-colors"
        >
          {t.sources}
        </a>
        <span aria-hidden="true"> · </span>
        <a
          href={getRelativeLocaleUrl(locale, "tags/")}
          class="underline hover:text-primary transition-colors"
        >
          {t.tags}
        </a>
        <span aria-hidden="true"> · </span>
        <a
          href={getRelativeLocaleUrl(locale, "about/")}
          class="underline hover:text-primary transition-colors"
        >
          {t.about}
        </a>
        <span aria-hidden="true"> · </span>
        <a
          href={getRelativeLocaleUrl(locale, "privacy/")}
          class="underline hover:text-primary transition-colors"
        >
          {t.privacy}
        </a>
        <span aria-hidden="true"> · </span>
        <a
          href={getRelativeLocaleUrl(locale, "terms/")}
          class="underline hover:text-primary transition-colors"
        >
          {t.terms}
        </a>
        {showGoogleTags && (
          <span id="privacy-choices" class="contents" hidden>
            <span aria-hidden="true"> · </span>
            <button
              type="button"
              class="underline hover:text-primary transition-colors"
            >
              {t.privacyChoices}
            </button>
          </span>
        )}
      </p>
    </footer>
  </body>
</html>
