---
import Layout from "@/layouts/main.astro"

interface Props {
  frontmatter: { title: string; description: string }
}

const { title, description } = Astro.props.frontmatter
---

<Layout title={`${title} | News Shuffle`} description={description}>
  <article class="mx-auto max-w-2xl space-y-4 leading-relaxed text-muted-foreground [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4 [&_h1]:mb-6 [&_h1]:text-4xl [&_h1]:font-semibold [&_h1]:text-foreground [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-medium [&_h2]:text-foreground">
    <slot />
  </article>
</Layout>
