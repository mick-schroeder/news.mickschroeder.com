---
import TagTile from "@/components/tag-tile.astro"
import PageHeader from "@/components/page-header.astro"
import Layout from "@/layouts/main.astro"
import { getTags } from "@/lib/data"
import { tagKinds } from "@/lib/tag-kinds"

const tags = await getTags()
const groups = tagKinds
  .map((kind) => ({
    title: kind.plural,
    tags: tags.filter((tag) => tag.kind === kind.id),
  }))
  .filter((group) => group.tags.length)
---

<Layout
  title="Tags | News Shuffle"
  description="Browse News Shuffle sources by tag."
  crumbs={[{ name: "Tags", path: "/tags/" }]}
>
  <PageHeader title="Tags" />
  <div class="space-y-8">
    {groups.map((group) => (
      <section>
        <h2 class="mb-3 text-2xl font-medium">{group.title}</h2>
        <ul class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          {group.tags.map((tag) => (
            <li>
              <TagTile
                tag={tag}
                href={`/tags/${tag.id}/`}
                title={tag.description}
                class="aspect-[3/2] rounded-xl p-4"
              >
                <span class="font-heading text-2xl font-medium sm:text-3xl">
                  {tag.title}
                </span>
              </TagTile>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
