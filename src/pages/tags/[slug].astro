---
import { ExternalLink } from "@/components/external-link"
import type { InferGetStaticPropsType } from "astro"
import PageHeader from "@/components/page-header.astro"
import SourceList from "@/components/source-list.astro"
import { TagIcon } from "@/components/tag-icon"
import { buttonVariants } from "@/components/ui/button"
import { Shuffle } from "lucide-react"
import Layout from "@/layouts/main.astro"
import { getSources, getTags, getTiers } from "@/lib/data"
import { itemList } from "@/lib/json-ld"

export async function getStaticPaths() {
  return (await getTags()).map((tag) => ({
    params: { slug: tag.id },
    props: { tag },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { tag } = Astro.props
const sources = (await getSources()).filter((source) =>
  source.tags.includes(tag.id)
)
const tiers = await getTiers()
const items = sources.map((source) => ({
  name: source.title,
  url: new URL(`/sources/${source.id}/`, Astro.site),
}))
---

<Layout
  title={`${tag.title} | News Shuffle`}
  description={tag.description}
  jsonLd={[itemList(items)]}
  crumbs={[
    { name: "Tags", path: "/tags/" },
    { name: tag.title, path: Astro.url.pathname },
  ]}
>
  <PageHeader title={tag.title} description={tag.description}>
    <TagIcon slot="icon" tag={tag} className="size-8" />
    {tag.url && (
      <ExternalLink
        href={tag.url}
        className="block text-sm underline underline-offset-4"
      >
        {new URL(tag.url).hostname}
      </ExternalLink>
    )}
    <a
      href={`/tags/${tag.id}/redirect/`}
      rel="nofollow"
      class={buttonVariants({ size: "xl", className: "mt-2" })}
    >
      <Shuffle data-icon="inline-start" aria-hidden="true" />
      Shuffle {tag.title}
    </a>
  </PageHeader>
  <SourceList sources={sources} tiers={tiers} />
</Layout>
