---
import ShareLinks from "@/components/share-links.astro"
import { ExternalLink } from "@/components/external-link"
import { TagBadge } from "@/components/tag-badge"
import { SourceIcon } from "@/components/source-icon"
import { TierBadge } from "@/components/tier-badge"
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/main.astro"
import { sourcePage } from "@/lib/json-ld"
import { cn, hostOf } from "@/lib/utils"
import { getSources, getTags, getTiers } from "@/lib/data"
import { tagKinds } from "@/lib/tag-kinds"
import type { InferGetStaticPropsType } from "astro"
import { Shuffle } from "lucide-react"

export async function getStaticPaths() {
  const sources = await getSources()
  return sources.map((source) => ({
    params: { id: source.id },
    props: { source, sources },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { source, sources } = Astro.props
const tags = await getTags()
const tiers = await getTiers()
const tierOf = (id: string) => tiers.find((tier) => tier.id === id)!
const tier = tierOf(source.tier)
const sourceTags = tags.filter((tag) => source.tags.includes(tag.id))
const groups = tagKinds
  .map((kind) => {
    const kindTags = sourceTags.filter((tag) => tag.kind === kind.id)
    return {
      label: kindTags.length > 1 ? kind.plural : kind.singular,
      tags: kindTags,
    }
  })
  .filter((group) => group.tags.length > 0)
const similar = source.similar
  .map((id) => sources.find((other) => other.id === id))
  .filter((other) => other !== undefined)
const site = Astro.site!
const page = new URL(Astro.url.pathname, site)
const url = page.href
---

<Layout
  title={`${source.title} | News Shuffle`}
  description={source.description}
  jsonLd={[sourcePage(site, page, source)]}
  crumbs={[
    { name: "Sources", path: "/sources/" },
    { name: source.title, path: Astro.url.pathname },
  ]}
>
  <!-- Source, tier and share on the left; similar sources beside on wide screens. -->
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div>
      <!-- Same layout as the home card: icon, name and website, tier. -->
      <div class="flex items-center gap-4">
        <SourceIcon source={source} className="size-16" />
        <div class="min-w-0 flex-1">
          <h1 class="text-4xl font-semibold">{source.title}</h1>
          <ExternalLink
            href={source.url}
            className="text-muted-foreground hover:text-foreground hover:underline"
          >
            {hostOf(source.url)}
          </ExternalLink>
        </div>
        <TierBadge tier={tier} className="size-11 text-lg" />
      </div>
      <p class="mt-6 text-lg text-pretty text-foreground/80">
        {source.description}
      </p>
      <div class="mt-6 flex gap-2">
        <a
          href="/"
          class={cn(
            buttonVariants({ size: "xl" }),
            "flex-1 sm:flex-none sm:px-8"
          )}
        >
          <Shuffle data-icon="inline-start" aria-hidden="true" />
          Shuffle
        </a>
        <ExternalLink
          href={source.url}
          button={{ variant: "outline", size: "xl" }}
        >
          Open
        </ExternalLink>
      </div>

      <dl class="mt-10 divide-y border-y">
        <div class="grid gap-2 py-4 sm:grid-cols-[8rem_1fr]">
          <dt class="text-sm text-muted-foreground">Tier</dt>
          <dd class="flex items-start gap-3">
            <TierBadge tier={tier} className="size-7" />
            <span>
              <a
                href={`/sources/#tier-${tier.id.toLowerCase()}`}
                class="font-medium hover:underline"
              >
                {tier.title}
              </a>
              <span class="block text-sm text-muted-foreground">
                {tier.description}
              </span>
            </span>
          </dd>
        </div>
        {groups.map((group) => (
          <div class="grid gap-2 py-4 sm:grid-cols-[8rem_1fr]">
            <dt class="text-sm text-muted-foreground">{group.label}</dt>
            <dd>
              <ul class="flex flex-wrap gap-1.5">
                {group.tags.map((tag) => (
                  <li>
                    <TagBadge tag={tag} />
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>

      <section class="mt-10">
        <h2 class="mb-3 text-lg font-medium">Share {source.title}</h2>
        <ShareLinks title={`${source.title} on News Shuffle`} url={url} />
      </section>
    </div>

    {similar.length > 0 && (
      <aside>
        <h2 class="mb-3 text-lg font-medium">Similar sources</h2>
        <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
          {similar.map((other) => (
            <li>
              <a
                href={`/sources/${other.id}/`}
                class="flex items-center gap-3 rounded-xl p-3 ring-1 ring-foreground/10 transition-colors hover:bg-muted"
              >
                <SourceIcon source={other} className="size-10" />
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-medium">{other.title}</span>
                  <span class="block truncate text-sm text-muted-foreground">
                    {hostOf(other.url)}
                  </span>
                </span>
                <TierBadge tier={tierOf(other.tier)} className="size-7" />
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/sources/"
          class={cn(buttonVariants({ variant: "outline" }), "mt-4")}
        >
          See all {sources.length} sources
        </a>
      </aside>
    )}
  </div>
</Layout>
