---
import SourceList from "@/components/source-list.astro"
import Layout from "@/layouts/main.astro"
import { getSources, getTiers } from "@/lib/data"
import { itemList } from "@/lib/json-ld"

const sources = await getSources()
const tiers = await getTiers()
const items = sources.map((source) => ({
  name: source.title,
  url: new URL(`/sources/${source.id}/`, Astro.site),
}))
---

<Layout
  title="Sources | News Shuffle"
  description="Every source News Shuffle can take you to, by tier."
  jsonLd={[itemList(items)]}
>
  <h1 class="mb-2 text-4xl font-semibold">Sources</h1>
  <p class="mb-8 text-lg text-muted-foreground">
    All {sources.length} sources, best tier first.
  </p>
  <SourceList sources={sources} tiers={tiers} />
</Layout>
