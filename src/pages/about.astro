---
import { ExternalLink } from "@/components/external-link"
import Prose from "@/layouts/prose.astro"
import { dataset } from "@/lib/json-ld"
import { TierBadge } from "@/components/tier-badge"
import { getTiers } from "@/lib/data"
import { CODE_URL, DATA_API, DATA_CODE_URL } from "@/consts"

const tiers = await getTiers()
const files = ["sources.json", "tags.json", "tiers.json"]
---

<Prose
  title="About"
  description="News Shuffle takes you to a random news source."
  jsonLd={[dataset(Astro.site!)]}
>
  <p>
    News Shuffle takes you to a random news source. Pick topics, regions, feeds
    and tiers, then shuffle.
  </p>

  <h2>Where the sources come from</h2>
  <p>
    Every night, the list is rebuilt from news feeds like Newzit, Techmeme and
    the Drudge Report, which consistently surface what people are reading and
    talking about.
  </p>

  <h2>How sources are judged</h2>
  <p>
    Each new source passes through an AI editor: is it news, is it in English,
    what is it about, how far does its reach extend. A source no feed has listed
    for three months is retired.
  </p>

  <h2>Tiers</h2>
  <p>
    Every source gets a tier for its reach and influence, not its viewpoint.
  </p>
  <ul class="space-y-3">
    {tiers.map((tier) => (
      <li class="flex items-start gap-3">
        <TierBadge tier={tier} className="size-7" />
        <span>
          <a href={`/sources/#tier-${tier.id.toLowerCase()}`}>{tier.title}</a>.{" "}
          {tier.description}
        </span>
      </li>
    ))}
  </ul>

  <h2>Open source</h2>
  <p>
    Data API:{" "}
    {files.map((file, index) => (
      <>
        {index > 0 && ", "}
        <ExternalLink href={`${DATA_API}/${file}`}>{file}</ExternalLink>
      </>
    ))}
    . Code: <ExternalLink href={DATA_CODE_URL}>popular-news-sites</ExternalLink>
    , <ExternalLink href={CODE_URL}>news.mickschroeder.com</ExternalLink>.
  </p>
</Prose>
