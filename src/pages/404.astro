---
import Layout from "@/layouts/main.astro"
import { buttonVariants } from "@/components/ui/button"
import { defaultLocale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"

const t = translations[defaultLocale]
---

<Layout title={t.notFound} description={t.notFound} noindex>
  <main class="page-width min-h-[60vh] max-w-2xl space-y-6 py-16">
    <h1 class="heading-page">{t.notFound}</h1>
    <div>
      <a href="/" class={buttonVariants({ size: "lg" })}>
        {t.home}
      </a>
    </div>
  </main>
</Layout>
