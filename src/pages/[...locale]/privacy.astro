---
import LegalLayout from "@/layouts/legal.astro"
import type EnglishCopy from "@/components/legal/privacy/en.astro"
import { translations } from "@/i18n/ui"
import {
  defaultLocale,
  localizedPaths,
  resolveLocale,
  type Locale,
} from "@/i18n/locales"
import { site } from "@/lib/site"

export const getStaticPaths = localizedPaths

const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const documents = import.meta.glob<{ default: typeof EnglishCopy }>(
  "../../components/legal/privacy/*.astro",
  { eager: true }
)
const path = (code: Locale) => `../../components/legal/privacy/${code}.astro`
const contentLocale = documents[path(locale)] ? locale : defaultLocale
const Copy = documents[path(contentLocale)].default
---

<LegalLayout
  contentLocale={contentLocale}
  heading={t.privacy}
  description={t.privacyDescription}
>
  <p slot="byline" class="mt-1 font-semibold text-foreground">
    {site.owner}
  </p>
  <Copy />
</LegalLayout>
