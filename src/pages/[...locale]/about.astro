---
import BrowsePage from "@/components/sources/browse-page.astro"
import ExternalLink from "@/components/external-link.astro"
import { TierBadge } from "@/components/tier-badge"
import { localizedPaths, type Locale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"
import { getTags } from "@/lib/catalog"
import { defaultFeedUrl } from "@/lib/feed"
import { localePath } from "@/lib/paths"
import { facets, tiers } from "@/lib/sites"

export const getStaticPaths = localizedPaths

const { locale }: { locale: Locale } = Astro.props
const t = translations[locale]
const { seenOn } = facets(await getTags())
const updated = new Date().toLocaleDateString(
  locale === "ga" ? "ga-IE" : "en-IE",
  { day: "numeric", month: "long", year: "numeric" }
)
const repo = "https://github.com/mick-schroeder"
const link = "text-foreground underline hover:text-primary transition-colors"

const copy = {
  en: {
    intro:
      "News Shuffle takes you to a random news site. Pick topics, places and tiers, then shuffle.",
    sourcesTitle: "Where the sites come from",
    sources:
      "Every night, the list is rebuilt from the sites these news aggregators link to:",
    judgedTitle: "How sites are judged",
    judged:
      "Each new site is judged once by an AI model (Claude): whether it is news, a one-line description, its tags and a tier. Sites known for misinformation are left out. A site no aggregator has listed for three months is retired.",
    tiersTitle: "Tiers",
    tiers:
      "Tiers run from S, the sites that set the news agenda, down to E, sites not rated yet. They are an AI judgment of reach and influence, not of quality or viewpoint.",
    dataTitle: "Data and code",
    data: "The list is open data:",
    code: "Code:",
    updated: `List updated ${updated}.`,
  },
  ga: {
    intro:
      "Tugann News Shuffle chuig suíomh nuachta randamach thú. Roghnaigh ábhair, áiteanna agus grádanna, ansin cas.",
    sourcesTitle: "Cá as a dtagann na suíomhanna",
    sources:
      "Gach oíche, atógtar an liosta ó na suíomhanna a nascann na comhbhailitheoirí nuachta seo leo:",
    judgedTitle: "Conas a mheastar na suíomhanna",
    judged:
      "Meastar gach suíomh nua uair amháin le samhail AI (Claude): an nuacht é, cur síos aon líne, a chlibeanna agus a ghrád. Fágtar amach suíomhanna atá ar eolas as mífhaisnéis. Scortar suíomh nach bhfuil liostaithe ag aon chomhbhailitheoir le trí mhí.",
    tiersTitle: "Grádanna",
    tiers:
      "Téann na grádanna ó S, na suíomhanna a leagann clár na nuachta amach, síos go E, suíomhanna nach bhfuil grádaithe fós. Breithiúnas AI ar fhairsinge agus ar thionchar atá iontu, ní ar cháilíocht ná ar dhearcadh.",
    dataTitle: "Sonraí agus cód",
    data: "Is sonraí oscailte an liosta:",
    code: "Cód:",
    updated: `Nuashonraíodh an liosta ${updated}.`,
  },
}[locale]
const heading = "mt-8 text-lg font-bold tracking-tight text-foreground"
---

<BrowsePage
  locale={locale}
  title={`${t.about} | News Shuffle`}
  heading={t.about}
  description={copy.intro}
  languageSuffix="about/"
  crumbs={[
    { label: "News Shuffle", href: localePath(locale) },
    { label: t.about },
  ]}
>
  <p slot="description" class="max-w-2xl text-muted-foreground">
    {copy.intro}
  </p>
  <div class="max-w-2xl space-y-3 leading-relaxed text-muted-foreground">
    <h2 class={heading}>{copy.sourcesTitle}</h2>
    <p>{copy.sources}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-1">
      {seenOn.map((tag) => (
        <li>
          {tag.url ? (
            <ExternalLink href={tag.url} class={link} locale={locale}>
              {tag.title}
            </ExternalLink>
          ) : (
            <a href={localePath(locale, `tags/${tag.id}/`)} class={link}>
              {tag.title}
            </a>
          )}
        </li>
      ))}
    </ul>

    <h2 class={heading}>{copy.judgedTitle}</h2>
    <p>{copy.judged}</p>

    <h2 class={heading}>{copy.tiersTitle}</h2>
    <ul class="flex gap-1.5" aria-label={copy.tiersTitle}>
      {tiers.map((tier) => (
        <li>
          <a href={localePath(locale, `sources/#tier-${tier.toLowerCase()}`)}>
            <TierBadge tier={tier} locale={locale} />
          </a>
        </li>
      ))}
    </ul>
    <p>{copy.tiers}</p>

    <h2 class={heading}>{copy.dataTitle}</h2>
    <p>
      {copy.data}{" "}
      <ExternalLink
        href={`${defaultFeedUrl}/sources.json`}
        class={link}
        locale={locale}
      >
        sources.json
      </ExternalLink>
      ,{" "}
      <ExternalLink
        href={`${defaultFeedUrl}/tags.json`}
        class={link}
        locale={locale}
      >
        tags.json
      </ExternalLink>
      .
    </p>
    <p>
      {copy.code}{" "}
      <ExternalLink
        href={`${repo}/popular-news-sites`}
        class={link}
        locale={locale}
      >
        popular-news-sites
      </ExternalLink>
      ,{" "}
      <ExternalLink
        href={`${repo}/news.mickschroeder.com`}
        class={link}
        locale={locale}
      >
        news.mickschroeder.com
      </ExternalLink>
      .
    </p>
    <p class="pt-4 text-sm">{copy.updated}</p>
  </div>
</BrowsePage>
