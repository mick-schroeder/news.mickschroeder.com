---
import { getRelativeLocaleUrl } from "astro:i18n"
import BrowsePage from "@/components/sources/browse-page.astro"
import ExternalLink from "@/components/external-link.astro"
import { TierBadge } from "@/components/tier-badge"
import { localizedPaths, resolveLocale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"
import { defaultFeedUrl } from "@/lib/feed"
import { tiers } from "@/lib/sites"
import { site } from "@/lib/site"

export const getStaticPaths = localizedPaths

const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const link = "link text-foreground"
const heading = "mt-8 text-lg font-bold tracking-tight text-foreground"
---

<BrowsePage
  title={t.about}
  description={t.aboutIntro}
  crumbs={[{ label: t.about }]}
>
  <p slot="description" class="max-w-2xl text-muted-foreground">
    {t.aboutIntro}
  </p>
  <div class="max-w-2xl space-y-3 leading-relaxed text-muted-foreground">
    <h2 class={heading}>{t.aboutSourcesTitle}</h2>
    <p>{t.aboutSources}</p>

    <h2 class={heading}>{t.aboutJudgedTitle}</h2>
    <p>{t.aboutJudged}</p>

    <h2 class={heading}>{t.tiers}</h2>
    <ul class="flex gap-1.5" aria-label={t.tiers}>
      {tiers.map((tier) => (
        <li>
          <a
            href={`${getRelativeLocaleUrl(locale, "sources/")}#tier-${tier.toLowerCase()}`}
          >
            <TierBadge tier={tier} locale={locale} />
          </a>
        </li>
      ))}
    </ul>
    <p>{t.aboutTiers}</p>

    <h2 class={heading}>{t.aboutOpenSource}</h2>
    <p>
      {t.aboutApi}{" "}
      <ExternalLink href={`${defaultFeedUrl}/sources.json`} class={link}>
        sources.json
      </ExternalLink>
      ,{" "}
      <ExternalLink href={`${defaultFeedUrl}/tags.json`} class={link}>
        tags.json
      </ExternalLink>
      .
    </p>
    <p>
      {t.aboutCode}{" "}
      <ExternalLink href={`${site.github}/popular-news-sites`} class={link}>
        popular-news-sites
      </ExternalLink>
      ,{" "}
      <ExternalLink href={`${site.github}/news.mickschroeder.com`} class={link}>
        news.mickschroeder.com
      </ExternalLink>
      .
    </p>
  </div>
</BrowsePage>
