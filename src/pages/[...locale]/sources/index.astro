---
import BrowsePage from "@/components/sources/browse-page.astro"
import TierList from "@/components/sources/tier-list.astro"
import { getSites, getTags } from "@/lib/catalog"
import { browsableTags } from "@/lib/sites"
import { localizedPaths, type Locale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"
import { localePath } from "@/lib/paths"

export const getStaticPaths = localizedPaths

const { locale }: { locale: Locale } = Astro.props
const t = translations[locale]
const sites = await getSites()
const filters = browsableTags(await getTags())
---

<BrowsePage
  locale={locale}
  title={`${t.sources} | News Shuffle`}
  heading={t.sources}
  description={t.allSourcesDescription}
  languageSuffix="sources/"
  crumbs={[
    { label: "News Shuffle", href: localePath(locale) },
    { label: t.sources },
  ]}
>
  <p slot="description" class="text-muted-foreground">
    {t.allSourcesDescription}
  </p>
  <TierList locale={locale} sites={sites} filters={filters} />
</BrowsePage>
