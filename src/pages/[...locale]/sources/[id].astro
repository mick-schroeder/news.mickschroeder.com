---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import { ChevronLeft, ChevronRight } from "lucide-react"
import Layout from "@/layouts/main.astro"
import { PageBreadcrumb } from "@/components/sources/page-breadcrumb"
import {
  SimilarSites,
  SourceDetails,
} from "@/components/sources/source-details"
import { buttonVariants } from "@/components/ui/button"
import { getSites, getTags } from "@/lib/catalog"
import { localeParam, locales, resolveLocale } from "@/i18n/locales"
import { format, translations } from "@/i18n/ui"
import { hostOf, neighbours, similarSites } from "@/lib/sites"
import { cn } from "@/lib/utils"

export const getStaticPaths = (async () => {
  const sites = await getSites()
  const tags = await getTags()
  return locales.flatMap((locale) =>
    sites.map((source, index) => ({
      params: {
        locale: localeParam(locale),
        id: source.id,
      },
      props: {
        source,
        tags,
        similar: similarSites(source, sites, tags),
        ...neighbours(sites, index),
      },
    }))
  )
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { source, tags, similar, previous, next } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const sourceUrl = (id: string) => getRelativeLocaleUrl(locale, `sources/${id}/`)
const host = hostOf(source.url)
const arrow = buttonVariants({ variant: "outline", size: "icon-lg" })
---

<Layout
  title={source.title}
  description={
    source.description ||
    format(t.sourceDescription, { name: source.title, host })
  }
>
  <!-- Same width as the header and footer on every page, so ads only use the
       outer margins. -->
  <main class="page-width max-w-5xl pt-4 sm:pt-8">
    <div class="mx-auto max-w-3xl space-y-6">
      <PageBreadcrumb
        locale={locale}
        crumbs={[
          { label: t.sources, href: getRelativeLocaleUrl(locale, "sources/") },
          { label: source.title },
        ]}
      />

      <!-- Arrows stay put whatever the card's height: above it on phones, level
         with its header beside it on wider screens. -->
      <div class="grid grid-cols-2 items-start gap-3 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:gap-4 [&>a]:sm:mt-9">
        <a
          href={sourceUrl(previous.id)}
          rel="prev"
          data-astro-prefetch
          class={cn(arrow, "justify-self-start")}
          aria-label={t.previous}
          title={previous.title}
        >
          <ChevronLeft aria-hidden="true" />
        </a>
        <div class="order-last col-span-2 min-w-0 sm:order-none sm:col-span-1">
          <SourceDetails source={source} tags={tags} locale={locale} />
        </div>
        <a
          href={sourceUrl(next.id)}
          rel="next"
          data-astro-prefetch
          class={cn(arrow, "justify-self-end")}
          aria-label={t.next}
          title={next.title}
        >
          <ChevronRight aria-hidden="true" />
        </a>
      </div>
      <SimilarSites sites={similar} locale={locale} />
    </div>
  </main>
</Layout>

<script>
  // Left and right arrow keys follow the previous and next links.
  document.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
    const target = event.target
    if (target instanceof Element && target.closest("input, select, textarea"))
      return
    const rel = { ArrowLeft: "prev", ArrowRight: "next" }[event.key]
    document.querySelector<HTMLAnchorElement>(`a[rel="${rel}"]`)?.click()
  })
</script>
