---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import Layout from "@/layouts/main.astro"
import { PageBreadcrumb } from "@/components/sources/page-breadcrumb"
import { ShareButtons } from "@/components/sources/share-buttons"
import {
  SimilarSources,
  SourceDetails,
  SourceNav,
} from "@/components/sources/source-details"
import { getSources, getTags } from "@/lib/catalog"
import { localeParam, locales, resolveLocale } from "@/i18n/locales"
import { format, translations } from "@/i18n/ui"
import {
  hashOf,
  hostOf,
  neighbours,
  pickSource,
  seededRandom,
  similarSources,
} from "@/lib/sources"

export const getStaticPaths = (async () => {
  const sources = await getSources()
  const tags = await getTags()
  return locales.flatMap((locale) =>
    sources.map((source, index) => {
      const { previous, next } = neighbours(sources, index)
      const skip = [source.id, previous.id, next.id]
      return {
        params: {
          locale: localeParam(locale),
          id: source.id,
        },
        props: {
          source,
          tags,
          // Prev/next already have their own buttons.
          similar: similarSources(source, sources, tags, 6, skip),
          random: pickSource(
            sources,
            skip,
            seededRandom(hashOf(`${source.id}~`))
          )!,
          previous,
          next,
        },
      }
    })
  )
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { source, tags, similar, previous, next, random } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const t = translations[locale]
const host = hostOf(source.url)
---

<Layout
  title={source.title}
  description={
    source.description ||
    format(t.sourceDescription, { name: source.title, host })
  }
>
  <!-- Same width as the header and footer on every page, so ads only use the
       outer margins. -->
  <main class="page-width space-y-6 pt-2 sm:pt-4">
    <!-- Full page width, where the browse pages put it. -->
    <PageBreadcrumb
      locale={locale}
      crumbs={[
        { label: t.sources, href: getRelativeLocaleUrl(locale, "sources/") },
        { label: source.title },
      ]}
    />
    <div class="mx-auto max-w-3xl space-y-6 pt-2 sm:pt-4">
      <!-- Same controls above and below; the top set never moves. -->
      <div class="flex flex-col gap-4">
        <SourceNav
          source={source}
          previous={previous}
          next={next}
          random={random}
          locale={locale}
        />
        <SourceDetails source={source} tags={tags} locale={locale} />
        <SourceNav
          source={source}
          previous={previous}
          next={next}
          random={random}
          locale={locale}
        />
      </div>
      <div class="flex justify-center">
        <ShareButtons
          client:idle
          locale={locale}
          source={{ id: source.id, title: source.title }}
        />
      </div>
      <SimilarSources sources={similar} locale={locale} />
    </div>
  </main>
</Layout>

<script>
  // Left and right arrow keys follow the previous and next links.
  document.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
    const target = event.target
    if (target instanceof Element && target.closest("input, select, textarea"))
      return
    const rel = { ArrowLeft: "prev", ArrowRight: "next" }[event.key]
    document.querySelector<HTMLAnchorElement>(`a[rel="${rel}"]`)?.click()
  })

  // Random gets a fresh pick per click once the id list loads; until then it
  // keeps the build-time pick.
  const randoms = document.querySelectorAll<HTMLAnchorElement>(
    "[data-random-source]"
  )
  if (randoms.length) {
    const current = randoms[0].dataset.randomSource!
    const ids = fetch("/source-ids.json")
      .then((response) => response.json() as Promise<string[]>)
      .catch(() => [])
    for (const random of randoms)
      random.addEventListener("click", async (event) => {
        const others = (await ids).filter((id) => id !== current)
        if (!others.length) return
        event.preventDefault()
        const id = others[Math.floor(Math.random() * others.length)]
        location.href = location.pathname.replace(`/${current}/`, `/${id}/`)
      })
  }
</script>
