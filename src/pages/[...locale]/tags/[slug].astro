---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro"
import { getRelativeLocaleUrl } from "astro:i18n"
import { ExternalLink, Shuffle } from "lucide-react"
import BrowsePage from "@/components/sources/browse-page.astro"
import { TagChips } from "@/components/sources/tag-chips"
import TierList from "@/components/sources/tier-list.astro"
import { buttonVariants } from "@/components/ui/button"
import { getSites, getTags } from "@/lib/catalog"
import { browsableTags, hostOf, tagLabel } from "@/lib/sites"
import { localeParam, locales, resolveLocale } from "@/i18n/locales"
import { format, translations } from "@/i18n/ui"
import { cn } from "@/lib/utils"

export const getStaticPaths = (async () => {
  const tags = browsableTags(await getTags())
  return locales.flatMap((locale) =>
    tags.map((tag) => ({
      params: {
        locale: localeParam(locale),
        slug: tag.id,
      },
      props: { tag, tags },
    }))
  )
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { tag, tags } = Astro.props
const locale = resolveLocale(Astro.currentLocale)
const slug = tag.id
const t = translations[locale]
const label = tagLabel(tag, locale)
const sources = (await getSites()).filter((source) =>
  source.tags.includes(tag.id)
)
---

<BrowsePage
  title={label}
  description={format(t.tagDescription, { label })}
  crumbs={[
    { label: t.tags, href: getRelativeLocaleUrl(locale, "tags/") },
    { label },
  ]}
>
  {tag.url && (
    <a
      slot="description"
      href={tag.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-sm font-medium text-foreground underline-offset-4 hover:underline"
    >
      {hostOf(tag.url)}
      <span class="sr-only">({t.opensInNewTab})</span>
      <ExternalLink className="size-3.5" aria-hidden="true" />
    </a>
  )}
  <p slot="description" class="text-muted-foreground" lang="en">
    {tag.description}
  </p>
  <a
    slot="actions"
    href={getRelativeLocaleUrl(locale, `tags/${slug}/redirect/`)}
    class={cn(buttonVariants({ size: "lg" }), "font-bold")}
  >
    <Shuffle data-icon="inline-start" strokeWidth={3} aria-hidden="true" />
    {format(t.shuffleTag, { label })}
  </a>
  <TagChips locale={locale} tags={tags} current={tag.id} label={t.tags} />
  <TierList sites={sources} />
</BrowsePage>
