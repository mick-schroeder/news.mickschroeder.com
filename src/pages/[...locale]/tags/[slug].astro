---
import { getRelativeLocaleUrl } from "astro:i18n"
import { ExternalLink, Shuffle } from "lucide-react"
import BrowsePage from "@/components/sources/browse-page.astro"
import { TagChips } from "@/components/sources/tag-chips"
import TierList from "@/components/sources/tier-list.astro"
import { buttonVariants } from "@/components/ui/button"
import { getSites, getTags } from "@/lib/catalog"
import { browsableTags, hostOf, tagLabel, type Tag } from "@/lib/sites"
import { defaultLocale, locales, type Locale } from "@/i18n/locales"
import { format, translations } from "@/i18n/ui"
import { cn } from "@/lib/utils"

export async function getStaticPaths() {
  const tags = browsableTags(await getTags())
  return locales.flatMap((locale) =>
    tags.map((tag) => ({
      params: {
        locale: locale === defaultLocale ? undefined : locale,
        slug: tag.id,
      },
      props: { locale, tag, tags },
    }))
  )
}

interface Props {
  locale: Locale
  tag: Tag
  tags: Tag[]
}

const { locale, tag, tags } = Astro.props
const slug = tag.id
const t = translations[locale]
const label = tagLabel(tag, locale)
const sources = (await getSites()).filter((source) =>
  source.tags.includes(tag.id)
)
---

<BrowsePage
  locale={locale}
  title={`${label} | News Shuffle`}
  heading={label}
  description={format(t.tagDescription, { label })}
  languageSuffix={`tags/${slug}/`}
  crumbs={[
    { label: "News Shuffle", href: getRelativeLocaleUrl(locale) },
    { label: t.tags, href: getRelativeLocaleUrl(locale, "tags/") },
    { label },
  ]}
>
  <p slot="description" class="text-muted-foreground" lang="en">
    {tag.description}
  </p>
  <a
    slot="actions"
    href={getRelativeLocaleUrl(locale, `tags/${slug}/redirect/`)}
    class={cn(buttonVariants({ size: "lg" }), "font-bold")}
  >
    <Shuffle data-icon="inline-start" strokeWidth={3} aria-hidden="true" />
    {format(t.shuffleTag, { label })}
  </a>
  {tag.url && (
    <a
      slot="actions"
      href={tag.url}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonVariants({ variant: "outline", size: "lg" })}
    >
      {hostOf(tag.url)}
      <span class="sr-only">({t.opensInNewTab})</span>
      <ExternalLink data-icon="inline-end" aria-hidden="true" />
    </a>
  )}
  <TagChips locale={locale} tags={tags} current={tag.id} label={t.tags} />
  <TierList locale={locale} sites={sources} />
</BrowsePage>
