---
import { getRelativeLocaleUrl } from "astro:i18n"
import BrowsePage from "@/components/sources/browse-page.astro"
import { TagTable } from "@/components/sources/tag-table"
import { getSites, getTags } from "@/lib/catalog"
import { browsableTags } from "@/lib/sites"
import { localizedPaths, type Locale } from "@/i18n/locales"
import { translations } from "@/i18n/ui"

export const getStaticPaths = localizedPaths

const { locale }: { locale: Locale } = Astro.props
const t = translations[locale]
const sites = await getSites()
const rows = browsableTags(await getTags()).map((tag) => ({
  tag,
  locale,
  href: getRelativeLocaleUrl(locale, `tags/${tag.id}/`),
  examples: sites.filter((s) => s.tags.includes(tag.id)).slice(0, 5),
}))
---

<BrowsePage
  locale={locale}
  title={`${t.tags} | News Shuffle`}
  heading={t.tags}
  description={t.tagsDescription}
  languageSuffix="tags/"
  crumbs={[
    { label: "News Shuffle", href: getRelativeLocaleUrl(locale) },
    { label: t.tags },
  ]}
>
  <p slot="description" class="text-muted-foreground">
    {t.tagsDescription}
  </p>
  <TagTable rows={rows} />
</BrowsePage>
