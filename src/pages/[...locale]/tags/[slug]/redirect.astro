---
import ShuffleRedirect from "@/components/shuffle-redirect.astro"
import { getTags } from "@/lib/catalog"
import { browsableTags } from "@/lib/sites"
import { defaultLocale, locales, type Locale } from "@/i18n/locales"

export async function getStaticPaths() {
  const tags = browsableTags(await getTags())
  return locales.flatMap((locale) =>
    tags.map((tag) => ({
      params: {
        locale: locale === defaultLocale ? undefined : locale,
        slug: tag.id,
      },
      props: { locale, tag: tag.id },
    }))
  )
}

const { locale, tag }: { locale: Locale; tag: string } = Astro.props
---

<ShuffleRedirect locale={locale} tag={tag} />
